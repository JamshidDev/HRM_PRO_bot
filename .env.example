# ─── HRM Telegram Bot — env namuna ───
# Nusxa oling: cp .env.example .env.local (yoki .env.development / .env.production)
# 3 rejim: .env.local (lokal), .env.development (dev), .env.production (prod).
# Ishga tushirish: npm run local | npm run dev | npm run prod

# Telegram bot tokeni (@BotFather). Local/dev va PROD uchun ALOHIDA token.
# Backend'ga Bot-Token header sifatida ham shu yuboriladi —
# backend .env dagi TELEGRAM_BOT_TOKEN bilan bir xil bo'lishi shart.
BOT_TOKEN=

# HRM backend API bazasi:
#   local → http://localhost:8001
#   dev   → https://dev-hrm-api.das-uty.uz
#   prod  → https://hrm-api.railway.uz
SERVICE_URL=

# Xatolik xabarnomalari yuboriladigan telegram chat_id
NOTIFICATION_ID=

# ─── Xato loglari: @hrm_logger_bot → guruhdagi "Bot" topic'i ───
# LOGGER_BOT_TOKEN yoki LOG_CHAT_ID bo'sh bo'lsa logger jim o'chadi —
# xatolar faqat konsolga chiqadi (lokal ishlash uchun normal holat).
# chat_id / thread_id ni qanday topish → docs/LOGGING.md

# @hrm_logger_bot tokeni (asosiy BOT_TOKEN'dan ALOHIDA)
LOGGER_BOT_TOKEN=

# Loglar tushadigan guruh chat_id (forum guruh: -100... bilan boshlanadi)
LOG_CHAT_ID=

# "Bot" topic'ining message_thread_id (bo'sh bo'lsa umumiy oqimga tushadi)
LOG_THREAD_ID=

# Xabar sarlavhasida ko'rinadigan muhit nomi: local | dev | prod
LOG_ENV=

# Ixtiyoriy sozlamalar (bo'sh qoldirilsa default ishlaydi):
# Bir xil xato necha ms ichida qayta yuborilmasin — default 300000 (5 daqiqa)
# LOG_DEDUP_WINDOW_MS=300000
# Daqiqada maksimal xabar soni — default 20 (Telegram guruh limiti ~20/min)
# LOG_MAX_PER_MIN=20
# console.error'larni ham topic'ga yuborish — default true
# LOG_CONSOLE_ERRORS=true
